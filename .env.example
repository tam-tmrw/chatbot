DATABASE_URL=mysql://vi:vi@127.0.0.1:3306/vi_chatbot
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ADMIN_SECRET=change-me
MANYCHAT_CALLBACK_SECRET=change-me
PUBLIC_BASE_URL=https://your-https-host.example
HYUNDAI_ACCESS_CODE=change
HUGGIES_ACCESS_CODE=change
# Gender-specific result videos (comma-separated). Random pick within the matching pool.
HUGGIES_VIDEO_URLS_BOY=https://example.s3.amazonaws.com/boy-a.mp4,https://example.s3.amazonaws.com/boy-b.mp4
HUGGIES_VIDEO_URLS_GIRL=https://example.s3.amazonaws.com/girl-a.mp4,https://example.s3.amazonaws.com/girl-b.mp4
# Fallback when gender is unspecified, or when boy/girl pools are empty
HUGGIES_VIDEO_URLS=https://example.s3.amazonaws.com/a.mp4,https://example.s3.amazonaws.com/b.mp4
HUGGIES_PREVIEW_URL=
HUGGIES_LEARN_MORE_URL=https://www.huggies.com.vn
# Shared by Flow + Guide consent (Guide always shows this URL in chat)
HUGGIES_TERMS_URL=#
HUGGIES_TERMS_VERSION=huggies-video-2026-11
HUGGIES_DELAY_MS=3000
HUGGIES_LLM_TIMEOUT_MS=8000
HUGGIES_GUIDE_TIMEOUT_MS=5000
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Pitch: when AWS auth fails, accept photo anyway (set 0 to hard-fail)
HUGGIES_REKOGNITION_SOFT=1
